# ---- Discord (required) ----
# Bot token: Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=
# Application ID: Developer Portal > General Information
CLIENT_ID=

# ---- AI custom art (optional) ----
# cloudflare | openrouter | off   (empty = cloudflare if CF vars are set, else off)
# If AI fails, times out (25s), runs out of quota, or is off -> the purple template image is sent instead.
AI_PROVIDER=

# Cloudflare Workers AI (free tier ~7-8 images/day with flux-2-dev)
# Account ID: dash.cloudflare.com (right side). Token: My Profile > API Tokens > "Workers AI" template
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-2-dev
CF_STEPS=16

# OpenRouter (paid credits) - https://openrouter.ai/keys
OPENROUTER_API_KEY=
# google/gemini-2.5-flash-image (best scene match) or openai/gpt-5-image-mini (cheaper)
OPENROUTER_MODEL=google/gemini-2.5-flash-image
